      "source": [
        "# ============================================================\n",
        "# CELL 5: Phantom Binary Format (PBF) — Ultra-Compressed Output\n",
        "# ============================================================\n",
        "#\n",
        "#  PBF is designed for MAXIMUM data shrinkage. Every character\n",
        "#  that is not data is removed. The format uses:\n",
        "#\n",
        "#  1. Single-character keys (e=etag, p=profiles, 1/2/3=tiers)\n",
        "#  2. Positional arrays instead of named keys where possible\n",
        "#  3. Rounded floats with minimal precision (2-4 decimal places)\n",
        "#  4. Boolean shortening (true→1, false→0)\n",
        "#  5. No whitespace, no newlines, no indentation\n",
        "#  6. Nested arrays for character params (ordered, no keys)\n",
        "#\n",
        "#  Character array order (positional):\n",
        "#  [centroid, crest, loRatio, hiRatio, warmth, f0,\n",
        "#   loGain, midGain, hiGain, harmDrive, bassDepth,\n",
        "#   glue, attack, release]\n",
        "#\n",
        "#  This reduces a typical profile from ~800 bytes (pretty JSON)\n",
        "#  to ~250 bytes (PBF) — a 69% reduction.\n",
        "# ============================================================\n",
        "\n",
        "def encode_pbf(data):\n",
        "    \"\"\"Encode profile data as Phantom Binary Format (ultra-compressed JSON).\"\"\"\n",
        "    p = data['profiles']\n",
        "    e = data['etag']\n",
        "    sr = data['sampleRate']\n",
        "    ch = data['channels']\n",
        "    dur = data['duration']\n",
        "\n",
        "    # Tier 1: [lufsI, truePeakDb, gainDb]\n",
        "    t1 = [p[1]['lufsI'], p[1]['truePeakDb'], p[1]['gainDb']]\n",
        "\n",
        "    # Tier 2: [lufsI, truePeakDb, gainDb, [char_array]]\n",
        "    c2 = p[2].get('character', {})\n",
        "    t2 = [p[2]['lufsI'], p[2]['truePeakDb'], p[2]['gainDb'], char_to_array(c2)]\n",
        "\n",
        "    # Tier 3: [lufsI, truePeakDb, gainDb, [char_array]]\n",
        "    c3 = p[3].get('character', {})\n",
        "    t3 = [p[3]['lufsI'], p[3]['truePeakDb'], p[3]['gainDb'], char_to_array(c3)]\n",
        "\n",
        "    # Final structure: {e,s,c,d,p:{1:[...],2:[...],3:[...]}}\n",
        "    pbf = {\n",
        "        'e': e,\n",
        "        's': sr,\n",
        "        'c': ch,\n",
        "        'd': dur,\n",
        "        'p': {\n",
        "            '1': t1,\n",
        "            '2': t2,\n",
        "            '3': t3,\n",
        "        }\n",
        "    }\n",
        "    return json.dumps(pbf, separators=(',', ':'))\n",
        "\n",
        "\n",
        "def char_to_array(ch):\n",
        "    \"\"\"Convert character dict to positional array (no keys).\"\"\"\n",
        "    if not ch:\n",
        "        return []\n",
        "    return [\n",
        "        ch.get('spectralCentroid', 0),\n",
        "        ch.get('crestFactor', 0),\n",
        "        ch.get('lowEndRatio', 0),\n",
        "        ch.get('highEndRatio', 0),\n",
        "        ch.get('harmonicWarmthIndex', 0),\n",
        "        ch.get('fundamentalFreq', 0),\n",
        "        ch.get('loGainDb', 0),\n",
        "        ch.get('midGainDb', 0),\n",
        "        ch.get('hiGainDb', 0),\n",
        "        ch.get('harmonicDrive', 0),\n",
        "        ch.get('bassEnhanceDepth', 0),\n",
        "        1 if ch.get('glueEnabled') else 0,\n",
        "        ch.get('transientAttack', 0),\n",
        "        ch.get('transientRelease', 0),\n",
        "    ]\n",
        "\n",
        "\n",
        "def decode_pbf(pbf_str):\n",
        "    \"\"\"Decode PBF back to full profile structure (for verification).\"\"\"\n",
        "    raw = json.loads(pbf_str)\n",
        "    p = raw['p']\n",
        "\n",
        "    profiles = {}\n",
        "    # Tier 1\n",
        "    profiles[1] = {\n",
        "        'lufsI': p['1'][0],\n",
        "        'truePeakDb': p['1'][1],\n",
        "        'gainDb': p['1'][2],\n",
        "    }\n",
        "    # Tier 2\n",
        "    profiles[2] = {\n",
        "        'lufsI': p['2'][0],\n",
        "        'truePeakDb': p['2'][1],\n",
        "        'gainDb': p['2'][2],\n",
        "        'character': array_to_char(p['2'][3]) if len(p['2']) > 3 else None,\n",
        "    }\n",
        "    # Tier 3\n",
        "    profiles[3] = {\n",
        "        'lufsI': p['3'][0],\n",
        "        'truePeakDb': p['3'][1],\n",
        "        'gainDb': p['3'][2],\n",
        "        'character': array_to_char(p['3'][3]) if len(p['3']) > 3 else None,\n",
        "    }\n",
        "\n",
        "    return {\n",
        "        'etag': raw['e'],\n",
        "        'profiles': profiles,\n",
        "        'sampleRate': raw['s'],\n",
        "        'channels': raw['c'],\n",
        "        'duration': raw['d'],\n",
        "    }\n",
        "\n",
        "\n",
        "def array_to_char(arr):\n",
        "    \"\"\"Convert positional array back to character dict.\"\"\"\n",
        "    if not arr:\n",
        "        return None\n",
        "    return {\n",
        "        'spectralCentroid': arr[0],\n",
        "        'crestFactor': arr[1],\n",
        "        'lowEndRatio': arr[2],\n",
        "        'highEndRatio': arr[3],\n",
        "        'harmonicWarmthIndex': arr[4],\n",
        "        'fundamentalFreq': arr[5],\n",
        "        'loGainDb': arr[6],\n",
        "        'midGainDb': arr[7],\n",
        "        'hiGainDb': arr[8],\n",
        "        'harmonicDrive': arr[9],\n",
        "        'bassEnhanceDepth': arr[10],\n",
        "        'glueEnabled': bool(arr[11]),\n",
        "        'transientAttack': arr[12],\n",
        "        'transientRelease': arr[13],\n",
        "    }\n",
        "\n",
        "\n",
        "print('✓ PBF encoder ready')\n",
        "print('  Format: {e,s,c,d,p:{1:[lufs,tp,gain],2:[lufs,tp,gain,[char]],3:[...]}}')\n",
        "print('  Char array: [centroid,crest,loR,hiR,warmth,f0,loG,midG,hiG,harm,bass,glue,atk,rel]')"
      ]
    },

        "# CELL 6: Process Audio Files\n",
        "# ============================================================\n",
        "#  Reads filenames from Encor/filenames.txt\n",
        "#  Processes each audio file from Echo/\n",
        "#  Outputs three files per audio to Profile_Outputs/\n",
        "# ============================================================\n",
        "\n",
        "# Read filenames to process\n",
        "with open(FILNAMES_FILE, 'r') as f:\n",
        "    filenames = [line.strip() for line in f if line.strip() and not line.startswith('#')]\n",
        "\n",
        "if not filenames:\n",
        "    print('⚠ No filenames in filenames.txt')\n",
        "    print(f'  Add filenames to: {FILNAMES_FILE}')\n",
        "    print(f'  Audio files should be in: {ECHO}')\n",
        "    # Auto-discover files in Echo/\n",
        "    import glob\n",
        "    auto_files = glob.glob(os.path.join(ECHO, '*'))\n",
        "    if auto_files:\n",
        "        filenames = [os.path.basename(f) for f in auto_files if os.path.isfile(f)]\n",
        "        print(f'  Auto-discovered {len(filenames)} file(s) in Echo/')\n",
        "    else:\n",
        "        print('  No files found in Echo/ either.')\n",
        "\n",
        "print(f'\\n📋 Files to process: {len(filenames)}')\n",
        "for i, name in enumerate(filenames):\n",
        "    print(f'  {i+1}. {name}')\n",
        "print()\n",
        "\n",
        "# Process each file\n",
        "for idx, filename in enumerate(filenames):\n",
        "    audio_path = os.path.join(ECHO, filename)\n",
        "    base_name = os.path.splitext(filename)[0]\n",
        "\n",
        "    print(f'─────────────────────────────────────────────')\n",
        "    print(f'[{idx+1}/{len(filenames)}] {filename}')\n",
        "\n",
        "    if not os.path.exists(audio_path):\n",
        "        print(f'  ✗ File not found: {audio_path}')\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        t0 = time.time()\n",
        "\n",
        "        # Generate profiles\n",
        "        profile_data = generate_profiles(audio_path)\n",
        "\n",
        "        elapsed = time.time() - t0\n",
        "        print(f'  Processed in {elapsed:.1f}s')\n",
        "\n",
        "        # Output 1: Pretty JSON (human-readable)\n",
        "        pretty_path = os.path.join(OUTPUTS, f'{base_name}.pretty.json')\n",
        "        with open(pretty_path, 'w') as f:\n",
        "            json.dump(profile_data, f, indent=2)\n",
        "        pretty_size = os.path.getsize(pretty_path)\n",
        "\n",
        "        # Output 2: Compact JSON (minified)\n",
        "        compact_path = os.path.join(OUTPUTS, f'{base_name}.compact.json')\n",
        "        with open(compact_path, 'w') as f:\n",
        "            json.dump(profile_data, f, separators=(',', ':'))\n",
        "        compact_size = os.path.getsize(compact_path)\n",
        "\n",
        "        # Output 3: PBF (Phantom Binary Format — ultra-compressed)\n",
        "        pbf_str = encode_pbf(profile_data)\n",
        "        pbf_path = os.path.join(OUTPUTS, f'{base_name}.pbf')\n",
        "        with open(pbf_path, 'w') as f:\n",
        "            f.write(pbf_str)\n",
        "        pbf_size = os.path.getsize(pbf_path)\n",
        "\n",
        "        # Verify PBF round-trip\n",
        "        decoded = decode_pbf(pbf_str)\n",
        "        assert decoded['etag'] == profile_data['etag']\n",
        "        assert decoded['profiles'][3]['character']['loGainDb'] == profile_data['profiles'][3]['character']['loGainDb']\n",
        "\n",
        "        # Size comparison\n",
        "        reduction = (1 - pbf_size / pretty_size) * 100\n",
        "        print(f'  ✓ Outputs:')\n",
        "        print(f'    pretty.json  {pretty_size:>6} bytes')\n",
        "        print(f'    compact.json {compact_size:>6} bytes')\n",
        "        print(f'    .pbf         {pbf_size:>6} bytes  ({reduction:.0f}% smaller than pretty)')\n",
        "        print(f'  ✓ PBF round-trip verified')\n",
        "        print(f'  ETag: {profile_data[\"etag\"][:16]}...')\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f'  ✗ Error: {e}')\n",
        "        import traceback\n",
        "        traceback.print_exc()\n",
        "\n",
        "print(f'\\n─────────────────────────────────────────────')\n",
        "print(f'✓ Done. Outputs in: {OUTPUTS}')"

        "# ============================================================\n",
        "# CELL 4: Profile Generation\n",
        "# ============================================================\n",
        "#  Generates three profiles per audio file:\n",
        "#    Tier 1: Loudness only (LUFS + true-peak + gain)\n",
        "#    Tier 2: Light enhancement (reduced character params)\n",
        "#    Tier 3: Full enhancement (all character params)\n",
        "# ============================================================\n",
        "\n",
        "TARGET_LUFS = -14.0\n",
        "LUFS_HEADROOM_DB = 0.3\n",
        "TRUE_PEAK_CEIL_DB = -1.0\n",
        "\n",
        "# Tier-specific analysis parameters\n",
        "TIER_PARAMS = {\n",
        "    1: {'lufs_max_sec': 0,   'char_max_sec': 0,  'fft_size': 1024, 'num_windows': 0, 'fir_taps': 8},\n",
        "    2: {'lufs_max_sec': 20,  'char_max_sec': 15, 'fft_size': 2048, 'num_windows': 4, 'fir_taps': 16},\n",
        "    3: {'lufs_max_sec': 45,  'char_max_sec': 30, 'fft_size': 4096, 'num_windows': 8, 'fir_taps': 32},\n",
        "}\n",
        "\n",
        "def generate_profiles(file_path):\n",
        "    \"\"\"Generate all three tier profiles for an audio file.\"\"\"\n",
        "    # Load audio\n",
        "    audio_data, sample_rate = sf.read(file_path, dtype='float64')\n",
        "    if audio_data.ndim == 1:\n",
        "        audio_data = audio_data.reshape(1, -1)\n",
        "    channels = [audio_data[c] for c in range(audio_data.shape[0])]\n",
        "    n_ch = len(channels)\n",
        "    duration = len(channels[0]) / sample_rate\n",
        "\n",
        "    print(f'  Loaded: {duration:.1f}s, {sample_rate}Hz, {n_ch}ch')\n",
        "\n",
        "    # Compute LUFS + true-peak (once, used by all tiers)\n",
        "    lufs_fast = fast_estimate_lufs(channels, sample_rate, duration)\n",
        "    lufs_i, true_peak_db = compute_lufs(channels, sample_rate, duration,\n",
        "                                          analysis_max_sec=TIER_PARAMS[3]['lufs_max_sec'],\n",
        "                                          )\n",
        "    # Compute gain\n",
        "    gain_db = (TARGET_LUFS - lufs_i) + LUFS_HEADROOM_DB\n",
        "    proj_peak = true_peak_db + gain_db\n",
        "    if proj_peak > TRUE_PEAK_CEIL_DB:\n",
        "        gain_db -= (proj_peak - TRUE_PEAK_CEIL_DB)\n",
        "\n",
        "    print(f'  LUFS={lufs_i:.1f}  truePeak={true_peak_db:.1f}dBTP  gain={gain_db:.2f}dB')\n",
        "\n",
        "    profiles = {}\n",
        "\n",
        "    # Tier 1: Loudness only\n",
        "    profiles[1] = {\n",
        "        'lufsI': round(lufs_i, 1),\n",
        "        'truePeakDb': round(true_peak_db, 1),\n",
        "        'gainDb': round(gain_db, 2),\n",
        "    }\n",
        "\n",
        "    # Tier 2: Light character\n",
        "    char2 = profile_character(\n",
        "        channels, sample_rate, duration,\n",
        "        char_max_sec=TIER_PARAMS[2]['char_max_sec'],\n",
        "        num_windows=TIER_PARAMS[2]['num_windows'],\n",
        "        fft_size=TIER_PARAMS[2]['fft_size'],\n",
        "        f0_min=80, f0_max=400\n",
        "    )\n",
        "    profiles[2] = {\n",
        "        'lufsI': round(lufs_i, 1),\n",
        "        'truePeakDb': round(true_peak_db, 1),\n",
        "        'gainDb': round(gain_db, 2),\n",
        "        'character': char2,\n",
        "    }\n",
        "\n",
        "    # Tier 3: Full character\n",
        "    char3 = profile_character(\n",
        "        channels, sample_rate, duration,\n",
        "        char_max_sec=TIER_PARAMS[3]['char_max_sec'],\n",
        "        num_windows=TIER_PARAMS[3]['num_windows'],\n",
        "        fft_size=TIER_PARAMS[3]['fft_size'],\n",
        "        f0_min=50, f0_max=1000\n",
        "    )\n",
        "    profiles[3] = {\n",
        "        'lufsI': round(lufs_i, 1),\n",
        "        'truePeakDb': round(true_peak_db, 1),\n",
        "        'gainDb': round(gain_db, 2),\n",
        "        'character': char3,\n",
        "    }\n",
        "\n",
        "    # ETag\n",
        "    etag = compute_etag(file_path)\n",
        "\n",
        "    result = {\n",
        "        'etag': etag,\n",
        "        'profiles': profiles,\n",
        "        'sampleRate': sample_rate,\n",
        "        'channels': n_ch,\n",
        "        'duration': round(duration, 1),\n",
        "        'lufsFast': round(lufs_fast, 1),\n",
        "    }\n",
        "\n",
        "    return result\n",
        "\n",
        "print('✓ Profile generator ready')"
      ]

      "source": [
        "# ============================================================\n",
        "# CELL 3: DSP Engine — BS.1770-4 LUFS, True-Peak, Character\n",
        "# ============================================================\n",
        "#  This module replicates the exact algorithms used by the\n",
        "#  Phantom-Audio userscript, ensuring profile compatibility.\n",
        "# ============================================================\n",
        "\n",
        "def kweight_coeffs(sample_rate):\n",
        "    \"\"\"BS.1770-4 K-weighting filter coefficients.\"\"\"\n",
        "    # Stage 1 — high shelf\n",
        "    f0 = 1681.974450955533\n",
        "    G = 3.999843853973347\n",
        "    Q1 = 0.7071752369554196\n",
        "    K1 = math.tan(math.pi * f0 / sample_rate)\n",
        "    Vh = 10 ** (G / 20)\n",
        "    Vb = Vh ** 0.49966677415454674\n",
        "    d0 = 1 + K1 / Q1 + K1 * K1\n",
        "    hs = {\n",
        "        'b0': (Vh + Vb * K1 / Q1 + K1 * K1) / d0,\n",
        "        'b1': 2 * (K1 * K1 - Vh) / d0,\n",
        "        'b2': (Vh - Vb * K1 / Q1 + K1 * K1) / d0,\n",
        "        'a1': 2 * (K1 * K1 - 1) / d0,\n",
        "        'a2': (1 - K1 / Q1 + K1 * K1) / d0,\n",
        "    }\n",
        "    # Stage 2 — high pass\n",
        "    f1 = 38.13547087602444\n",
        "    Q2 = 0.5003270373238773\n",
        "    K2 = math.tan(math.pi * f1 / sample_rate)\n",
        "    d2 = 1 + K2 / Q2 + K2 * K2\n",
        "    hp = {\n",
        "        'b0': 1 / d2,\n",
        "        'b1': -2 / d2,\n",
        "        'b2': 1 / d2,\n",
        "        'a1': 2 * (K2 * K2 - 1) / d2,\n",
        "        'a2': (1 - K2 / Q2 + K2 * K2) / d2,\n",
        "    }\n",
        "    return [hs, hp]\n",
        "\n",
        "\n",
        "def apply_biquad_cascade(samples, bq_coeffs):\n",
        "    \"\"\"Apply cascaded biquad filters in-place.\"\"\"\n",
        "    for bq in bq_coeffs:\n",
        "        b0, b1, b2 = bq['b0'], bq['b1'], bq['b2']\n",
        "        a1, a2 = bq['a1'], bq['a2']\n",
        "        x1 = x2 = y1 = y2 = 0.0\n",
        "        for i in range(len(samples)):\n",
        "            x = samples[i]\n",
        "            y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2\n",
        "            x2 = x1; x1 = x; y2 = y1; y1 = y\n",
        "            samples[i] = y\n",
        "    return samples\n",
        "\n",
        "\n",
        "def compute_lufs(channels, sample_rate, duration, analysis_max_sec=45):\n",
        "    \"\"\"Full BS.1770-4 integrated loudness + true-peak.\"\"\"\n",
        "    n_ch = len(channels)\n",
        "    offset_sec = max(0, duration * 0.25)\n",
        "    max_sec = min(analysis_max_sec, duration - offset_sec)\n",
        "    start_smp = int(offset_sec * sample_rate)\n",
        "    max_smp = min(int(max_sec * sample_rate), len(channels[0]) - start_smp)\n",
        "\n",
        "    bq = kweight_coeffs(sample_rate)\n",
        "    W = [1.41 if c in (4, 5) else 1.0 for c in range(n_ch)]\n",
        "\n",
        "    kw = []\n",
        "    true_peak_lin = 0.0\n",
        "    for c in range(n_ch):\n",
        "        d = channels[c][start_smp:start_smp + max_smp].copy()\n",
        "        # True-peak: 4x oversample with 32-tap sinc FIR\n",
        "        tp = true_peak_channel(d, fir_taps=32)\n",
        "        if tp > true_peak_lin:\n",
        "            true_peak_lin = tp\n",
        "        apply_biquad_cascade(d, bq)\n",
        "        kw.append(d)\n",
        "\n",
        "    block_samp = int(0.4 * sample_rate)\n",
        "    hop_samp = int(0.1 * sample_rate)\n",
        "    total_samp = len(kw[0])\n",
        "    blocks = []\n",
        "    for s in range(0, total_samp - block_samp + 1, hop_samp):\n",
        "        ms = 0.0\n",
        "        for c in range(n_ch):\n",
        "            d = kw[c][s:s + block_samp]\n",
        "            ms += W[c] * np.dot(d, d) / block_samp\n",
        "        blocks.append(ms)\n",
        "\n",
        "    if not blocks:\n",
        "        return -70.0, 20 * math.log10(max(true_peak_lin, 1e-9))\n",
        "\n",
        "    to_lufs = lambda ms: -0.691 + 10 * math.log10(max(ms, 1e-12))\n",
        "    abs_gate = 10 ** ((-70 + 0.691) / 10)\n",
        "    g1 = [b for b in blocks if b >= abs_gate]\n",
        "    if not g1:\n",
        "        return -70.0, 20 * math.log10(max(true_peak_lin, 1e-9))\n",
        "    mean1 = sum(g1) / len(g1)\n",
        "    rel_gate = mean1 * 10 ** (-10 / 10)\n",
        "    g2 = [b for b in g1 if b >= rel_gate]\n",
        "    mean2 = sum(g2 if g2 else g1) / (len(g2) if g2 else len(g1))\n",
        "    return to_lufs(mean2), 20 * math.log10(max(true_peak_lin, 1e-9))\n",
        "\n",
        "\n",
        "def true_peak_channel(data, fir_taps=32, oversample=4):\n",
        "    \"\"\"4x oversampled true-peak measurement.\"\"\"\n",
        "    N = oversample\n",
        "    up = np.zeros(len(data) * N)\n",
        "    up[::N] = data * N\n",
        "\n",
        "    fc = 0.5 / N\n",
        "    taps = fir_taps\n",
        "    h = np.zeros(taps)\n",
        "    for k in range(taps):\n",
        "        n = k - (taps - 1) / 2\n",
        "        sinc = 1.0 if n == 0 else math.sin(math.pi * 2 * fc * n) / (math.pi * 2 * fc * n)\n",
        "        win = 0.42 - 0.5 * math.cos(2 * math.pi * k / (taps - 1)) + 0.08 * math.cos(4 * math.pi * k / (taps - 1))\n",
        "        h[k] = sinc * win\n",
        "    h /= h.sum()  # normalize\n",
        "\n",
        "    out = np.convolve(up, h, mode='full')[:len(up)]\n",
        "    return float(np.max(np.abs(out)))\n",
        "\n",
        "\n",
        "def fast_estimate_lufs(channels, sample_rate, duration, fast_sample_sec=6):\n",
        "    \"\"\"Quick LUFS estimate from a short window.\"\"\"\n",
        "    n_ch = len(channels)\n",
        "    offset_sec = min(max(0.30 * duration, 1.0), max(duration - fast_sample_sec - 1, 1.0))\n",
        "    start_smp = int(offset_sec * sample_rate)\n",
        "    max_smp = min(int(fast_sample_sec * sample_rate), len(channels[0]) - start_smp)\n",
        "    if max_smp < sample_rate:\n",
        "        return -70.0\n",
        "\n",
        "    bq = kweight_coeffs(sample_rate)\n",
        "    W = [1.41 if c in (4, 5) else 1.0 for c in range(n_ch)]\n",
        "    total_ms = 0.0\n",
        "    for c in range(n_ch):\n",
        "        d = channels[c][start_smp:start_smp + max_smp].copy()\n",
        "        apply_biquad_cascade(d, bq)\n",
        "        total_ms += W[c] * np.dot(d, d) / len(d)\n",
        "    if total_ms < 1e-12:\n",
        "        return -70.0\n",
        "    return -0.691 + 10 * math.log10(total_ms / n_ch)\n",
        "\n",
        "\n",
        "def profile_character(channels, sample_rate, duration, char_max_sec=30,\n",
        "                       num_windows=8, fft_size=4096,\n",
        "                       f0_min=50, f0_max=1000):\n",
        "    \"\"\"Full psychoacoustic character profile.\"\"\"\n",
        "    n_ch = len(channels)\n",
        "    max_smp = min(len(channels[0]), int(char_max_sec * sample_rate))\n",
        "\n",
        "    # Mix to mono\n",
        "    mono = np.zeros(max_smp, dtype=np.float64)\n",
        "    for c in range(n_ch):\n",
        "        mono += channels[c][:max_smp] / n_ch\n",
        "\n",
        "    # Crest factor\n",
        "    peak = float(np.max(np.abs(mono)))\n",
        "    rms_val = float(np.sqrt(np.mean(mono ** 2)))\n",
        "    crest_db = 20 * math.log10(peak / rms_val) if rms_val > 0 else 20.0\n",
        "\n",
        "    # Average spectrum via FFT\n",
        "    win_len = fft_size * 2\n",
        "    hann = np.hanning(win_len)\n",
        "    avg_mag = np.zeros(fft_size // 2)\n",
        "    wins_processed = 0\n",
        "\n",
        "    for w in range(num_windows):\n",
        "        offset = int((len(mono) - win_len) * (w / max(num_windows - 1, 1)))\n",
        "        if offset < 0 or offset + win_len > len(mono):\n",
        "            continue\n",
        "        segment = mono[offset:offset + win_len] * hann\n",
        "        spectrum = np.fft.rfft(segment)\n",
        "        mag = np.abs(spectrum[:fft_size // 2])\n",
        "        avg_mag += mag\n",
        "        wins_processed += 1\n",
        "\n",
        "    if wins_processed > 0:\n",
        "        avg_mag /= wins_processed\n",
        "\n",
        "    # Band energy\n",
        "    bin_hz = sample_rate / fft_size\n",
        "    lo_bin = int(250 / bin_hz)\n",
        "    m_bin = int(3500 / bin_hz)\n",
        "    lo_e = float(np.sum(avg_mag[:lo_bin] ** 2))\n",
        "    mid_e = float(np.sum(avg_mag[lo_bin:m_bin] ** 2))\n",
        "    hi_e = float(np.sum(avg_mag[m_bin:] ** 2))\n",
        "    total_e = lo_e + mid_e + hi_e\n",
        "    low_end_ratio = lo_e / total_e if total_e > 0 else 0.33\n",
        "    high_end_ratio = hi_e / total_e if total_e > 0 else 0.33\n",
        "\n",
        "    # Spectral centroid\n",
        "    freqs = np.arange(len(avg_mag)) * bin_hz\n",
        "    centroid = float(np.sum(freqs * avg_mag) / max(np.sum(avg_mag), 1e-9))\n",
        "\n",
        "    # f0 detection via autocorrelation\n",
        "    f0 = detect_f0(mono, sample_rate, f0_min, f0_max)\n",
        "\n",
        "    # Harmonic warmth\n",
        "    odd_e = even_e = 0.0\n",
        "    if f0 > 0:\n",
        "        for h in range(2, 13):\n",
        "            freq = f0 * h\n",
        "            bin_idx = int(freq / bin_hz)\n",
        "            if bin_idx >= len(avg_mag):\n",
        "                break\n",
        "            w2 = 2\n",
        "            lo = max(0, bin_idx - w2)\n",
        "            hi = min(len(avg_mag) - 1, bin_idx + w2)\n",
        "            e = float(np.sum(avg_mag[lo:hi+1] ** 2))\n",
        "            if h % 2 == 1:\n",
        "                odd_e += e\n",
        "            else:\n",
        "                even_e += e\n",
        "    harmonic_warmth = odd_e / (odd_e + even_e) if (odd_e + even_e) > 0 else 0.50\n",
        "\n",
        "    # Derive shaping parameters\n",
        "    lo_need = max(0, min(1, 1.0 - low_end_ratio / 0.55))\n",
        "    lo_gain_db = min(3.0, lo_need * 3.0)\n",
        "    mid_gain_db = -lo_gain_db * 0.20\n",
        "    hi_need = max(0, min(1, 1.0 - high_end_ratio / 0.45))\n",
        "    hi_gain_db = min(2.0, hi_need * 1.8)\n",
        "    crest_norm = max(0, min(1, (crest_db - 6) / 18))\n",
        "    warmth_gap = max(-0.2, min(0.5, 0.50 - harmonic_warmth)) / 0.5\n",
        "    harmonic_drive = min(0.20, max(0, (1 - crest_norm) * 0.6 + max(0, warmth_gap) * 0.4) * 0.20)\n",
        "    bass_enhance_depth = min(0.35, max(0, lo_need * 0.7 + (1 - crest_norm) * 0.3) * 0.35)\n",
        "    glue_enabled = crest_db < 14\n",
        "    transient_attack = max(0.005, min(0.030, 0.010 + crest_norm * 0.020))\n",
        "    transient_release = max(0.100, min(0.500, 0.150 + crest_norm * 0.250))\n",
        "\n",
        "    return {\n",
        "        'spectralCentroid': round(centroid, 1),\n",
        "        'crestFactor': round(crest_db, 1),\n",
        "        'lowEndRatio': round(low_end_ratio, 4),\n",
        "        'highEndRatio': round(high_end_ratio, 4),\n",
        "        'harmonicWarmthIndex': round(harmonic_warmth, 4),\n",
        "        'fundamentalFreq': round(f0, 1),\n",
        "        'loGainDb': round(lo_gain_db, 2),\n",
        "        'midGainDb': round(mid_gain_db, 2),\n",
        "        'hiGainDb': round(hi_gain_db, 2),\n",
        "        'harmonicDrive': round(harmonic_drive, 4),\n",
        "        'bassEnhanceDepth': round(bass_enhance_depth, 4),\n",
        "        'glueEnabled': glue_enabled,\n",
        "        'transientAttack': round(transient_attack, 4),\n",
        "        'transientRelease': round(transient_release, 4),\n",
        "    }\n",
        "\n",
        "\n",
        "def detect_f0(mono, sample_rate, min_f=50, max_f=1000):\n",
        "    \"\"\"Detect fundamental frequency via normalized autocorrelation.\"\"\"\n",
        "    target_sr = 16000\n",
        "    ratio = sample_rate / target_sr\n",
        "    ds_len = int(len(mono) / ratio)\n",
        "    ds = np.interp(np.arange(ds_len) * ratio, np.arange(len(mono)), mono)\n",
        "\n",
        "    min_lag = int(target_sr / max_f)\n",
        "    max_lag = int(target_sr / min_f)\n",
        "    N = min(len(ds), max_lag + 1)\n",
        "    if N < max_lag + 2:\n",
        "        return 0.0\n",
        "\n",
        "    best_lag = 0\n",
        "    best_corr = 0.0\n",
        "    for lag in range(min_lag, max_lag + 1):\n",
        "        s = np.dot(ds[:N-lag], ds[lag:N-lag+lag]) if lag > 0 else np.dot(ds[:N], ds[:N])\n",
        "        norm = np.dot(ds[:N], ds[:N])\n",
        "        corr = s / (norm + 1e-9)\n",
        "        if corr > best_corr:\n",
        "            best_corr = corr\n",
        "            best_lag = lag\n",
        "\n",
        "    if best_corr < 0.25:\n",
        "        return 0.0\n",
        "    return target_sr / best_lag\n",
        "\n",
        "\n",
        "def compute_etag(file_path):\n",
        "    \"\"\"Compute a file hash to use as ETag.\"\"\"\n",
        "    h = hashlib.md5()\n",
        "    with open(file_path, 'rb') as f:\n",
        "        # Read first 64KB + last 64KB + size for speed\n",
        "        head = f.read(65536)\n",
        "        f.seek(-65536, 2)\n",
        "        tail = f.read(65536)\n",
        "        size = f.seek(0, 2)\n",
        "    h.update(head)\n",
        "    h.update(tail)\n",
        "    h.update(str(size).encode())\n",
        "    return h.hexdigest()\n",
        "\n",
        "print('✓ DSP engine ready')"
      ]
    },
